     "text": "{\n \"批\": \"N26\",\n \"裁定\": [\n  {\n   \"编号\": \"T88-c4\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「跟太阳一样」只是拿太阳星的人作比较说火爆程度，并没有借太阳的形象说明为什么武曲的人火爆，理由仍只是有武曲这颗星，按直断。\"\n  },\n  {\n   \"编号\": \"T98-c2\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「白天」「分日月」在原文里是男女各配的出生昼夜条件，不是借日月形象去说明为什么男命最好，原文没有把日象当理由讲出来，故不记象。\"\n  },\n  {\n   \"编号\": \"T233-c1\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「一方之主」说的是这类人所居的地位性质（一方的首领），不是借人物形象或比喻来推论，归义不归象。\"\n  },\n  {\n   \"编号\": \"T233-c1\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"都是一方之主\",\n   \"理由\": \"原文以「都是一方之主」收束，院长正是「一方之主」这一类的实例，结论是前提性质的成员，合C2。\"\n  },\n  {\n   \"编号\": \"T233-c1\",\n   \"项\": \"C5\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"由当司法官推到干院长，不是按常理从司法官身份推出的得失去向，而是靠「一方之主」这一性质定其位阶，司法官只是限定路线，不构成人情事理推论。\"\n  },\n  {\n   \"编号\": \"T233-c2\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"同T233-c1，「一方之主」是地位性质而非借象推论。\"\n  },\n  {\n   \"编号\": \"T233-c2\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"都是一方之主\",\n   \"理由\": \"局长是「一方之主」的实例，结论为前提性质之成员。\"\n  },\n  {\n   \"编号\": \"T233-c2\",\n   \"项\": \"C5\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"由警察推到局长靠的是「一方之主」的性质，不是由警察身份按常理推出，不记人情。\"\n  },\n  {\n   \"编号\": \"T233-c3\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"同T233-c1，「一方之主」是地位性质而非借象推论。\"\n  },\n  {\n   \"编号\": \"T233-c3\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"都是一方之主\",\n   \"理由\": \"大使是「一方之主」的实例，结论为前提性质之成员。\"\n  },\n  {\n   \"编号\": \"T233-c3\",\n   \"项\": \"C5\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"由外交官推到大使靠的是「一方之主」的性质，不是由外交官身份按常理推出，不记人情。\"\n  },\n  {\n   \"编号\": \"T594-c1\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原文只说「天马星动了」就到外地去，没有像「空就是空掉了」那样点出马或动的字面意思作为理由，星名本身不算借象，不记C1。\"\n  },\n  {\n   \"编号\": \"T594-c2\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"同T594-c1，原文未明说借天马之象推出外调，只是列出天马星动的另一种应法。\"\n  },\n  {\n   \"编号\": \"T706-c1\",\n   \"项\": \"C2\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「武官星」只是用类别称呼进来的那颗星，原文没有把武官的性质当作父母离异的理由，仍是「有这类星进来就怎样」，不算以义为据。\"\n  },\n  {\n   \"编号\": \"T745-c1\",\n   \"项\": \"问D\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「太阴化忌代表妈妈，太阳也在这边」本身就是取象的依据（已记C1），原文没有再多一句解释为什么反背化忌会使父母不在身边或双亡，不算明说道理。\"\n  },\n  {\n   \"编号\": \"T958-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"化忌在这边\",\n   \"理由\": \"这一步交秋前出事主要靠化忌所在位置对应夏秋之交推出，化忌及其所在位置属四化与宫位，按说明归C3。\"\n  }\n ]\n}"
