     "text": "{\n \"批\": \"N19\",\n \"裁定\": [\n  {\n   \"编号\": \"T96-c2\",\n   \"项\": \"C5\",\n   \"裁定\": \"是\",\n   \"依据\": \"权力欲望啊非常重的人\",\n   \"理由\": \"原话以「因为为什么这里要提出来呢……权力欲望啊非常重的人」解释女命忌将星，是拿性情推吉凶，属人情事理；两人问D都已认此句为解释，C5应随之记是。\"\n  },\n  {\n   \"编号\": \"T197-c2\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"原文「巨门星代表的意义呢代表口舌，是非」说的是这颗星所主之事（它是什么），不是说某人怎样，按codebook属定名；口舌是非为抽象所主之事，归义名；没有再解释为什么，问D否。\"\n  },\n  {\n   \"编号\": \"T197-c3\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"同c2，原文「代表……官司牢狱之灾」「主牢狱之灾」是说星所主之事，属定名·义名；未进一步解释，问D否。\"\n  },\n  {\n   \"编号\": \"T327-c1\",\n   \"项\": \"C4\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「重用到第二个十年，34岁以后到43岁」是说受重用延续的时段，是结论的内容，不是推出受重用的理由。\"\n  },\n  {\n   \"编号\": \"T327-c1\",\n   \"项\": \"C5\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原话把受重用归于「天钺星就会受到重用」，去掉天钺则由当官推不出重用，按codebook应按附加条件那一环作答，而天钺只是有星即有结论，属直断。\"\n  },\n  {\n   \"编号\": \"T670-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原话只说「福德宫很差」就「不用谈了」，是有条件即有结论，未说出宫位关系在起作用；与两人都判为直断的T345（星入子女宫）同类，应保持一致。\"\n  },\n  {\n   \"编号\": \"T760-c1\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"「化忌是官司是非啊」是说化忌所主之事，给化忌定性质，不是断某人之事，属定名·义名；未再解释，问D否。\"\n  },\n  {\n   \"编号\": \"T914-c1\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"原文「这种八字就，我们算命就叫做财官双美」与codebook定名例「这种叫半空折翅」句式相同，是给这种盘面情形定名目；「财」「官」为所主之抽象吉事，归义名；未解释为什么，问D否。\"\n  },\n  {\n   \"编号\": \"T978-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"化忌的人\",\n   \"理由\": \"codebook把四化明列在C3之下，条件即化忌，与两人都记C3是的T664、T695（化忌、化禄）同类，应一致记是。\"\n  },\n  {\n   \"编号\": \"T978-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"化忌的人\",\n   \"理由\": \"同c1，四化按codebook归位，条件为化忌即记C3是。\"\n  },\n  {\n   \"编号\": \"T978-c3\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"化忌的人\",\n   \"理由\": \"同c1，条件为化忌，四化归C3。\"\n  },\n  {\n   \"编号\": \"T1428-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"这是化忌\",\n   \"理由\": \"「过忌」以化忌为参照，原话先点出「这是化忌」，化忌属四化，codebook归在C3，与C4时机可并记。\"\n  },\n  {\n   \"编号\": \"T1826-c1\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原话只举太太表面顺从私下找征信社的例子描述暗权，并未明说凭「暗」「权」字面或形象推出结论，甲自己也认为可视为直断。\"\n  }\n ]\n}"
