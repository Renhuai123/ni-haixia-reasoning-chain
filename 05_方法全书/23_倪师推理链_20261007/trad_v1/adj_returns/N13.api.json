     "text": "{\n \"批\": \"N13\",\n \"裁定\": [\n  {\n   \"编号\": \"T129-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"会同时会到，就是死在水里面了\",\n   \"理由\": \"原话紧接着说两处廉贞破军「会同时会到，就是死在水里面了」，把会照当作得出水中作冢的理由，属宫位关系在起作用。\"\n  },\n  {\n   \"编号\": \"T136-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「（庙旺）」为括号注记，讲课原话不可能说出括号，应视为整理者所加，原话并未说亮度在起作用，故按直断。\"\n  },\n  {\n   \"编号\": \"T306-c1\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"象名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"「如果是陀罗擎羊呢，就是看不到的小人」与前面「铃星火星」并举，是给这两颗星定一个名目（它们是什么），后文「遇到擎羊陀罗星进来的时候，往往你的小人就在你身边」才是断人；「小人」是人象，故象名；原话没有解释为何此星是小人，问D否。\"\n  },\n  {\n   \"编号\": \"T306-c2\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"象名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"同T306-c1，陀罗与擎羊并提，「就是看不到的小人」是给星定名目，「小人」为人象；未解释何以如此，问D否。\"\n  },\n  {\n   \"编号\": \"T306-c4\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"就是看不到的小人\",\n   \"理由\": \"原话先定这两颗星「就是看不到的小人」，再讲这种小人是身边亲近之人，「小人就在你身边」是这一所主之事的展开，星的性质被当作理由。\"\n  },\n  {\n   \"编号\": \"T306-c4\",\n   \"项\": \"C4\",\n   \"裁定\": \"是\",\n   \"依据\": \"擎羊陀罗星进来的时候\",\n   \"理由\": \"本条适用流年，「进来的时候」指流年星进入之时，原话末尾又以「流年逢到这两颗星」总结，时机在起作用。\"\n  },\n  {\n   \"编号\": \"T306-c5\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"就是看不到的小人\",\n   \"理由\": \"同T306-c4，陀罗被定为「看不到的小人」，「小人在身边」是该性质的展开。\"\n  },\n  {\n   \"编号\": \"T306-c5\",\n   \"项\": \"C4\",\n   \"裁定\": \"是\",\n   \"依据\": \"擎羊陀罗星进来的时候\",\n   \"理由\": \"同T306-c4，流年星进来之时，属时机。\"\n  },\n  {\n   \"编号\": \"T306-c8\",\n   \"项\": \"问D\",\n   \"裁定\": \"是\",\n   \"依据\": \"\",\n   \"理由\": \"原话除了说这两颗星是看不到的小人，还以「你看到外面很健康，里面有癌症，就开刀见血光」解释了这种小人为何会带来身体病灾，多于一句说明。\"\n  },\n  {\n   \"编号\": \"T306-c9\",\n   \"项\": \"问D\",\n   \"裁定\": \"是\",\n   \"依据\": \"\",\n   \"理由\": \"同T306-c8，「外面很健康，里面有癌症，就开刀见血光」是对病灾由来的进一步解释。\"\n  },\n  {\n   \"编号\": \"T328-c2\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"指的是财星，像禄存星在命\",\n   \"理由\": \"原话先说禄存「最重要的是指的是财星」，再用「像」引出在命小气，小气被当作财星性质的表现实例来讲，星的所主被当作理由。\"\n  },\n  {\n   \"编号\": \"T554-c2\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"是女儿的话就变成半子送终\",\n   \"理由\": \"由「没有儿子，是女儿」变成「半子送终」，是把女儿当作「半子」这一类别的同义改说，属类属关系。\"\n  },\n  {\n   \"编号\": \"T554-c2\",\n   \"项\": \"C5\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"结论只是改换称谓，不是由身份处境按常理推出得失去向，原话也未讲人情因果。\"\n  },\n  {\n   \"编号\": \"T630-c1\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"官禄宫是本条所在之宫，原话按其所主说当官，并未借宫名字面或形象比喻来推论。\"\n  },\n  {\n   \"编号\": \"T630-c1\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"有杀星在里面\",\n   \"理由\": \"条件不是某颗具体星而是「杀星」这一类别，原话凭杀星之凶性说「当然不容易」，与T1081-c1以「杀星」记C2一致。\"\n  },\n  {\n   \"编号\": \"T630-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"只说星在本宫（官禄宫）里面，与codebook反例「红鸾坐命」同类，未涉及对宫、三方、亮度、四化等位置关系。\"\n  },\n  {\n   \"编号\": \"T683-c1\",\n   \"项\": \"问D\",\n   \"裁定\": \"是\",\n   \"依据\": \"\",\n   \"理由\": \"原话在岁走夫妻宫、吉星来会之外，还以「先生人很厚道，一直也看不清楚啊就好吧」说明先生为何就此娶她，是对结婚缘由的进一步解释。\"\n  }\n ]\n}"
