     "text": "{\n \"批\": \"N28\",\n \"裁定\": [\n  {\n   \"编号\": \"T180-c2\",\n   \"项\": \"C2\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「贪狼也是横财」是前提本身，而结论「从商运道会很好」不是「横财」一类的成员或同义说法，是由横财运按事理推出的后果，故不按义。\"\n  },\n  {\n   \"编号\": \"T180-c2\",\n   \"项\": \"C4\",\n   \"裁定\": \"是\",\n   \"依据\": \"这30年\",\n   \"理由\": \"原文把从商运道好限定在「这30年」这段大限之内，时机是得出结论的条件之一，按时。\"\n  },\n  {\n   \"编号\": \"T180-c2\",\n   \"项\": \"C5\",\n   \"裁定\": \"是\",\n   \"依据\": \"也是横财，这30年如果从商了，运道会很好\",\n   \"理由\": \"有横财运则做生意运道好，是由处境按常理推出得失，前提与结论之间是事理因果。\"\n  },\n  {\n   \"编号\": \"T437-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"身在迁移\",\n   \"理由\": \"身宫落在迁移宫是一宫与另一宫重合的宫位关系，不是单纯有一颗星在某宫，原文即以此为由断到外地去，按位。\"\n  },\n  {\n   \"编号\": \"T510-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"在这个位置上\",\n   \"理由\": \"原文明说「在这个位置上」自然不想结婚，是把位置当理由，虽所指盘面不明，仍按位记。\"\n  },\n  {\n   \"编号\": \"T510-c2\",\n   \"项\": \"问D\",\n   \"裁定\": \"是\",\n   \"依据\": \"\",\n   \"理由\": \"前文「我就不要管婚姻好了，我就专心从事我的事业好了」解释了为何不结婚会让事业做得好，多说了一层道理。\"\n  },\n  {\n   \"编号\": \"T535-c1\",\n   \"项\": \"C1\",\n   \"裁定\": \"是\",\n   \"依据\": \"子女宫是空的对不对，是不是没有的\",\n   \"理由\": \"原文由「空」的字面意思推到「没有」，与「地空嘛，空就是空掉了」同式，借字义说理，按象。\"\n  },\n  {\n   \"编号\": \"T535-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"空宫只是盘面条件本身，不在宫位关系、亮度、四化、格局之列，原文也未说位置关系如何起作用，结论「本来就没有」靠的是「空」即「没有」。\"\n  },\n  {\n   \"编号\": \"T535-c2\",\n   \"项\": \"问D\",\n   \"裁定\": \"是\",\n   \"依据\": \"\",\n   \"理由\": \"原文除说太阳在子女宫降落外，还以「太阳星看不到了」解释为何看不到儿子，与「落陷了太阳不亮就看不清楚」同类，算明说道理。\"\n  },\n  {\n   \"编号\": \"T890-c1\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"才艺超人也是科\",\n   \"理由\": \"「也是科」是把才艺出众归入化科所主之事的一类，以类别为理由，按义。\"\n  },\n  {\n   \"编号\": \"T911-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"科在官禄\",\n   \"理由\": \"codebook把四化归在位，且原文将「科在官禄」与「科在命」分说、结论不同，是位置在起作用。\"\n  },\n  {\n   \"编号\": \"T911-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"科在命\",\n   \"理由\": \"化科属四化，且原文以科落在命宫与落在官禄对举而得不同结论，按位。\"\n  },\n  {\n   \"编号\": \"T920-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"官禄宫化科\",\n   \"理由\": \"依据是官禄宫的化科，四化按codebook归在位，与T911-c1同判。\"\n  },\n  {\n   \"编号\": \"T920-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"官禄宫化科\",\n   \"理由\": \"同T920-c1，理由是官禄宫化科，四化归位。\"\n  },\n  {\n   \"编号\": \"T921-c1\",\n   \"项\": \"问D\",\n   \"裁定\": \"是\",\n   \"依据\": \"\",\n   \"理由\": \"「当官的时候我们有个印盖一下，那个就是官印」解释了官印这一形象是什么，与例「宰相是辅佐皇帝的」同类，算多说一层。\"\n  },\n  {\n   \"编号\": \"T921-c2\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"「它代表的是性刚」与上句「代表的是官印」同式，是给化权定性质；「刚」在codebook义名例中，故定名义名；「个性很刚」只是复述，未解释为何，问D否。\"\n  },\n  {\n   \"编号\": \"T925-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"有科没有权\",\n   \"理由\": \"有科无权是四化的配置，codebook把四化归在位，原文以此为由断做参谋。\"\n  },\n  {\n   \"编号\": \"T957-c2\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"「化忌代表想不开」与两人都判定名的「化忌代表劫杀」同式，是列举化忌所代表的性质，说的是它是什么，抽象性质故为义名；没有再解释，问D否。\"\n  },\n  {\n   \"编号\": \"T962-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"太阴化忌\",\n   \"理由\": \"依据是太阴化忌，四化按codebook归在位，原文以此为由断与母相抗。\"\n  }\n ]\n}"
