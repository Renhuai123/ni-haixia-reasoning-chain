     "text": "{\n \"批\": \"Q01\",\n \"裁定\": [\n  {\n   \"编号\": \"qs-2-6-22:s001#3\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「加羊陀火铃空劫耗忌」只是罗列再多出哪些星，没有说出宫位、亮度、化入冲照或成格之类的位置关系，照 codebook「理由只是有这颗星或这个组合」归直断，「忌」在此也只是列举的星名。\"\n  },\n  {\n   \"编号\": \"qs-2-2-425:s001#4\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「遇吉」只说遇到吉星，说出的是吉这一性质（C2 已记），未说出会照、同宫、三方等任何位置关系，不记位。\"\n  },\n  {\n   \"编号\": \"qs-1-45-1:s006#1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「紫微吉星加」只说再加上紫微等吉星，是星曜组合而非位置关系，无宫位、亮度、四化、格局之说，不记位。\"\n  },\n  {\n   \"编号\": \"qs-1-45-1:s006#2\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"同上，「紫微吉星加」只是星曜相加，没有说出位置关系在起作用，不记位。\"\n  },\n  {\n   \"编号\": \"qs-1-45-1:s006#3\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「加红鸾」只说多一颗红鸾，是组合条件，未涉宫位、亮度、四化或格局，照 codebook 归直断。\"\n  },\n  {\n   \"编号\": \"qs-1-45-1:s006#4\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「加刑刃」只列再加的星，未说位置关系，不记位。\"\n  },\n  {\n   \"编号\": \"qs-2-13-8:s001#3\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「加羊陀火铃空劫」只是列出所加煞星，没有宫位、亮度、四化、格局的说法，与本句前两分句「入庙」「陷地」不同，不记位。\"\n  },\n  {\n   \"编号\": \"qs-2-13-17:s001#4\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「加羊陀火铃空劫」只是星曜相加的组合条件，未说位置关系，归直断。\"\n  },\n  {\n   \"编号\": \"qs-1-47-13:s001#1\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"「廉贞主下贱孤寒」以星为主语，说的是这颗星所主之事，与 codebook 义名例「主贵」「孤克」同式，是给星定性质而非对某人的断语；「下贱孤寒」为抽象处境、吉凶，无具体人物物象，故为义名；原文未再解释为什么，问D 否。\"\n  },\n  {\n   \"编号\": \"qs-1-47-13:s001#2\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"「太阴主一生快乐」与上半句对仗，同样是以星为主语说它所主之事，属给星定性质的义名（快乐是抽象吉凶，非人物物象）；原文无进一步解释，问D 否。\"\n  },\n  {\n   \"编号\": \"qs-2-10-20:s001#6\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「见羊陀火铃空劫」只说见到这些煞星，未说出会照、同宫、亮度、四化等位置关系，与本句「入庙」「会吉星」不同，归直断。\"\n  },\n  {\n   \"编号\": \"qs-1-7-19:s001#2\",\n   \"项\": \"C2\",\n   \"裁定\": \"是\",\n   \"依据\": \"驳杂\",\n   \"理由\": \"「驳杂」是对命限所逢星曜吉凶混杂这一性质的说法，原文把它当作一世迍邅的理由，与本批「凶乡」「吉曜」两人均记为义的处理一致，故记 C2。\"\n  }\n ]\n}"
