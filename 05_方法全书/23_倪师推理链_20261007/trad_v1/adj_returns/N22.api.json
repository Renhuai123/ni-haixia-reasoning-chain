     "text": "{\n \"批\": \"N22\",\n \"裁定\": [\n  {\n   \"编号\": \"T435-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原话只说「身在财帛」就会到私人企业，与反例「红鸾坐命」同为仅陈述某宫落在何处的条件，未说出位置关系在起作用，按直断。\"\n  },\n  {\n   \"编号\": \"T435-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"同T435-c1，「身在财帛……私人的公司很好」只是条件接结论，未说出位置关系如何起作用。\"\n  },\n  {\n   \"编号\": \"T457-c2\",\n   \"项\": \"C4\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「50岁的时候先生走」中的50岁是结论里事情发生的时间，原话未说出行运走到何宫或任何盘面依据，不能算把时机当理由。\"\n  },\n  {\n   \"编号\": \"T463-c4\",\n   \"项\": \"C2\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"codebook 问B 明列「桃花」为象名，「两个大桃花星」是先说星是什么东西再推结论，已记在C1，不再重复记为义。\"\n  },\n  {\n   \"编号\": \"T488-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"是\",\n   \"依据\": \"大运十年没有会到\",\n   \"理由\": \"原话全文紧接「大运十年没有会到」而说「40岁红鸾星才会动」，40岁才动的理由正是大运对红鸾的会照关系到40岁才成立，属位置（会照）在起作用。\"\n  },\n  {\n   \"编号\": \"T605-c2\",\n   \"项\": \"C2\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「财星吉星」只是条件本身的称呼，原话未像T778「这两个是科甲星」那样把星的性质说成理由，与T415「命坐财星」的处理一致，不记义。\"\n  },\n  {\n   \"编号\": \"T658-c1\",\n   \"项\": \"问D\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「福德宫代表一世的福禄」是C2所记的理由本身，其后直接「所以……很累」，没有再多一句解释为何福禄差就累，只有一层理由。\"\n  },\n  {\n   \"编号\": \"T662-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原话只说福德宫只有一颗右弼就更惨，是「有／没有某星某组合」的直断，未说出宫位、亮度、四化或成格与否在起作用。\"\n  },\n  {\n   \"编号\": \"T662-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「紫微星在福德，然后辅弼有那最好」只是有这个组合就好，未说位置关系如何起作用，按直断。\"\n  },\n  {\n   \"编号\": \"T662-c3\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「没有紫微星，只有辅弼星也不行」仍是以某星有无为条件直接得结论，原话未称之为格也未讲位置作用，与c1、c2一致按直断。\"\n  },\n  {\n   \"编号\": \"T990-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「39岁进入事业宫」是行运走到哪一宫，codebook 将其归于C4时机；原话未说该宫盘面或任何宫位、四化关系，不另记位。\"\n  }\n ]\n}"
