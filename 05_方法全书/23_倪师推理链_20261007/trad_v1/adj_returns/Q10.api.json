     "text": "{\n \"批\": \"Q10\",\n \"裁定\": [\n  {\n   \"编号\": \"qs-1-10-9:s001#1\",\n   \"项\": \"问B\",\n   \"裁定\": \"象名\",\n   \"依据\": \"\",\n   \"理由\": \"名目「左右守卫」含「守卫」这一具体护卫人象，按 codebook「名目里有具体的人、物、景象的字就答象名」的裁法取象名。\"\n  },\n  {\n   \"编号\": \"qs-1-15-1:s003#1\",\n   \"项\": \"问B\",\n   \"裁定\": \"象名\",\n   \"依据\": \"\",\n   \"理由\": \"「化囚为杀」中「囚」是囚徒之人象，依 codebook 拿不准时名目含具体人物字即答象名。\"\n  },\n  {\n   \"编号\": \"qs-2-2-479:s001#3\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"本步主要靠附加条件「更值巨门兼武曜」推出，而这只是说有这几颗星的组合，未说宫位、亮度、四化或成格，属直断。\"\n  },\n  {\n   \"编号\": \"qs-3-19-2:s001#2\",\n   \"项\": \"C4\",\n   \"裁定\": \"是\",\n   \"依据\": \"土到东南\",\n   \"理由\": \"「纵然吉曜相逢照」是让步条件，去掉它官灾仍由上句行限「土到东南逢震巽」推出，故按前提那一环作答，时机（行限所到）在起作用。\"\n  },\n  {\n   \"编号\": \"qs-2-11-13:s001#2\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「天同同」只是说天梁与天同同度这一星曜组合，未说宫位关系、亮度、四化或格局，依 codebook 属直断。\"\n  },\n  {\n   \"编号\": \"qs-2-11-13:s001#3\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「天机同不见羊陀火铃空劫」只说与何星同、不与何星相遇，仍是星曜组合的有无，没有位置关系在起作用。\"\n  },\n  {\n   \"编号\": \"qs-3-20-55:s002#1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「丙辛人」是生年干条件不属五类，「命中」只说坐命宫，与 codebook 反例「红鸾坐命（只说有星在命宫）」同类，作直断。\"\n  },\n  {\n   \"编号\": \"qs-2-2-441:s001#3\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「若遇羊火在其中」只说命宫中再有羊火这一组合，与反例「只说有星在命宫」同类，未说出宫位关系、亮度或四化。\"\n  },\n  {\n   \"编号\": \"qs-2-2-428:s001#3\",\n   \"项\": \"C4\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"本步由「若无吉曜来相照」这一附加条件推出招灾，去掉它就推不出，依 codebook 按附加条件那一环作答，只计位（会照），不另计上句的二限时机。\"\n  },\n  {\n   \"编号\": \"qs-3-20-158:s001#1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「廉贞四杀」及注「同羊陀火铃是也」只是说廉贞与四煞同度的组合、并解释四杀所指，未说宫位、亮度、四化或成格，属直断。\"\n  },\n  {\n   \"编号\": \"qs-3-20-158:s001#2\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「若安布此星同」仍只说这几颗星同处一宫的组合，没有位置关系在起作用，与#1同为直断。\"\n  },\n  {\n   \"编号\": \"qs-2-7-7:s001#4\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「七杀破军天府同」只说廉贞与这几星同度的组合，未说宫位关系、亮度或四化，依 codebook 属直断。\"\n  }\n ]\n}"
