     "text": "{\n \"批\": \"N23\",\n \"裁定\": [\n  {\n   \"编号\": \"T256-c2\",\n   \"项\": \"C2\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「她不重利，她完全重感觉」说的是此人的性情，不是说出破军星的性质类别，「最好」也不是「不重利」这一类的成员或同义说法，不属义。\"\n  },\n  {\n   \"编号\": \"T256-c2\",\n   \"项\": \"C5\",\n   \"裁定\": \"是\",\n   \"依据\": \"她不重利，她完全重感觉\",\n   \"理由\": \"「这种人最好了」紧接「她不重利，她完全重感觉」，是以性情推出做伴侣的好处，属性情与后果之间的人情事理。\"\n  },\n  {\n   \"编号\": \"T273-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「文昌文曲来会」只是陈述星在三方四正这一条件本身，并未说会照的位置关系在起作用，与「红鸾坐命」之反例同类，按直断。\"\n  },\n  {\n   \"编号\": \"T468-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原文只并列「七杀朝斗紫府坐垣」与「太太是武曲」便说同行，未说格局或宫位关系为何导出同行，只是列出条件，按直断。\"\n  },\n  {\n   \"编号\": \"T505-c2\",\n   \"项\": \"C1\",\n   \"裁定\": \"是\",\n   \"依据\": \"桃花星\",\n   \"理由\": \"前提是先把廉贞天钺说成「桃花星」这一物象，再由桃花推出只追漂亮的，符合 C1「先说出这颗星是什么东西，再由此推出结论」。\"\n  },\n  {\n   \"编号\": \"T505-c2\",\n   \"项\": \"C2\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「桃花」是象名（两人在 T505-c1 均判象名），借象推断归 C1，不再重复计为义。\"\n  },\n  {\n   \"编号\": \"T505-c2\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「坐夫妻宫」只是述及星所在的宫，原文未说宫位关系在起作用，按反例「红鸾坐命」不计位。\"\n  },\n  {\n   \"编号\": \"T505-c3\",\n   \"项\": \"C1\",\n   \"裁定\": \"是\",\n   \"依据\": \"桃花星\",\n   \"理由\": \"与 T505-c2 同，结论承「桃花星」这一物象而来，属借象推断。\"\n  },\n  {\n   \"编号\": \"T505-c3\",\n   \"项\": \"C2\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「桃花」为象名，已归 C1，原文未另说出性质类别作理由。\"\n  },\n  {\n   \"编号\": \"T505-c3\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「坐夫妻宫」只是陈述位置，未说宫位在起作用，与 T505-c2 一致不计位。\"\n  },\n  {\n   \"编号\": \"T616-c1\",\n   \"项\": \"C1\",\n   \"裁定\": \"是\",\n   \"依据\": \"朋友宫是小人\",\n   \"理由\": \"原文把这颗星说成「小人」这一人物，再由小人推出要注意提防，属借人物之象立论。\"\n  },\n  {\n   \"编号\": \"T616-c1\",\n   \"项\": \"C2\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「小人」是具体人物而非抽象性质，按 codebook 有人物字的归象不归义。\"\n  },\n  {\n   \"编号\": \"T621-c1\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"「叫做适得其所，叫做正位」是给官星入官禄宫这一盘面情形定名目，说的是「它是什么」而非人怎样，故定名；「适得其所」「正位」为抽象性质，属义名；未再解释为何。\"\n  },\n  {\n   \"编号\": \"T621-c2\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"与 T621-c1 同句，「叫做适得其所，叫做正位」是给财星入财帛宫这一情形定名，名目为抽象性质，故定名、义名，无进一步解释。\"\n  },\n  {\n   \"编号\": \"T621-c3\",\n   \"项\": \"整条\",\n   \"问A\": \"定名\",\n   \"问B\": \"象名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"理由\": \"「你的财星跑到官星里面就是贪官」与前文「叫做适得其所，叫做正位」同为给盘面配置定名目的句式，主语是配置本身，故定名；「贪官」为具体人物之象，属象名；未再说理。\"\n  },\n  {\n   \"编号\": \"T754-c1\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"摘录以「所以」起头，其理由在摘录之外；后文「日月反背格」是作为「夫妻聚少散多」的依据说的，原文未把它明说为「白天晚上都忙」的理由，故按直断。\"\n  },\n  {\n   \"编号\": \"T826-c2\",\n   \"项\": \"C5\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"由「24小时都通明」到「事业很大」的联系是靠「像日不落国一样」这一形象（C1）搭起的，原文未以性情与后果的人情事理说明，故不计情。\"\n  }\n ]\n}"
