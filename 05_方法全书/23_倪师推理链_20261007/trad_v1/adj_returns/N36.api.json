     "text": "{\n \"批\": \"N36\",\n \"裁定\": [\n  {\n   \"编号\": \"T114-c1\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「武官带→带兵打仗」是以武官这一类别的本来职事推出结论，属 C2（codebook 反例「将星的人适合当武官」即归 C2），原文并未借形象、比喻说明，故 C1 不计。\"\n  },\n  {\n   \"编号\": \"T114-c2\",\n   \"项\": \"C1\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"同 T114-c1，「到边疆去打仗」是武官一类的职事，原文只以类别推出，未另借形象，归 C2 不归 C1。\"\n  },\n  {\n   \"编号\": \"T355-c1\",\n   \"项\": \"C2\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「喜神」只是对天喜的称呼，原文把它当理由的是「逢到化忌」「男命」等条件，并未说出喜神的性质为何导致夫妻生离死别，故 C2 不计。\"\n  },\n  {\n   \"编号\": \"T439-c1\",\n   \"项\": \"问D\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「这个忌我们意思就是说有凶星在兄弟宫」只是把化忌译成凶星（已计入 C2），之后直接列解释，没有再说凶星为何带来兄弟不和，故问D为否。\"\n  },\n  {\n   \"编号\": \"T439-c2\",\n   \"项\": \"问D\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"同 T439-c1，原文只说有凶星就有兄弟夭折，未再解释为什么。\"\n  },\n  {\n   \"编号\": \"T439-c3\",\n   \"项\": \"问D\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"同 T439-c1，原文只说有凶星就有合伙破财，未再解释为什么。\"\n  },\n  {\n   \"编号\": \"T648-c1\",\n   \"项\": \"C1\",\n   \"裁定\": \"是\",\n   \"依据\": \"田宅宫就被贴在法院民事厅上\",\n   \"理由\": \"原文借「田宅宫被贴在法院民事厅上」的景象，并取田宅宫名的字面之义（房产）来说明为何被拍卖，属借形象与宫名字面推结论。\"\n  },\n  {\n   \"编号\": \"T648-c1\",\n   \"项\": \"C5\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"「贴在法院民事厅上」是对结果的形象描述，原文没有说出官司与拍卖之间的人情事理因果，故 C5 不计。\"\n  },\n  {\n   \"编号\": \"T648-c1\",\n   \"项\": \"问D\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原文除「官司是非的星」与这一形象说法外，没有再加一句解释为什么会被拍卖，故问D为否。\"\n  },\n  {\n   \"编号\": \"T910-c1\",\n   \"项\": \"C5\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原文只说「90岁100岁以后才有科，就代表说……死了以后才有名」，由年岁到「死后」的常理推断未在原文说出，依据只是时机（C4），故 C5 不计。\"\n  },\n  {\n   \"编号\": \"T1105-c3\",\n   \"项\": \"C3\",\n   \"裁定\": \"否\",\n   \"依据\": \"\",\n   \"理由\": \"原文只说「在疾厄宫……当然是左脚子我们都知道」，疾厄宫只是条件所在，宫位与左脚的对应关系原文并未说出，近于 codebook C3 反例，按直断处理。\"\n  }\n ]\n}"
