     "text": "{\n \"批\": \"S02\",\n \"裁定\": [\n  {\n   \"编号\": \"qs-1-4-1:s001\",\n   \"断语\": [\n    {\n     \"条件原文\": \"紫微帝座\",\n     \"判断原文\": \"以辅弼为佐\"\n    },\n    {\n     \"条件原文\": \"紫微帝座\",\n     \"判断原文\": \"贰作数中之主星乃有用之源流\"\n    }\n   ],\n   \"理由\": \"本句是给紫微定性：「以辅弼为佐」与「作数中之主星乃有用之源流」都是对紫微帝座的定性判断，属一个条件带出两个判断，各算一条；「以辅弼为佐」不是条件而是判断，故采甲。\"\n  },\n  {\n   \"编号\": \"qs-1-10-9:s001\",\n   \"断语\": [\n    {\n     \"条件原文\": \"若居官禄身命，三宫\",\n     \"判断原文\": \"最要左右守卫\"\n    }\n   ],\n   \"理由\": \"「三宫」即指官禄、身、命三宫，是宫位条件的一部分，判断本身是「最要左右守卫」，采乙。\"\n  },\n  {\n   \"编号\": \"qs-1-10-12:s002\",\n   \"断语\": [\n    {\n     \"条件原文\": \"更与武曲禄存同宫，身命中\",\n     \"判断原文\": \"尤为奇特\"\n    }\n   ],\n   \"理由\": \"「身命中」是宫位条件（在身命宫中），判断只是「尤为奇特」，采乙。\"\n  },\n  {\n   \"编号\": \"qs-1-10-23:s001\",\n   \"断语\": [\n    {\n     \"条件原文\": \"三方有吉拱\",\n     \"判断原文\": \"方作贵人评\"\n    },\n    {\n     \"条件原文\": \"若还无辅弼\",\n     \"判断原文\": \"诸恶共饮凌\"\n    },\n    {\n     \"条件原文\": \"若还无辅弼\",\n     \"判断原文\": \"帝为无道主\"\n    }\n   ],\n   \"理由\": \"歌诀两两对仗，「若还无辅弼」与前句「三方有吉拱」同为条件句，「诸恶共饮凌」是无辅弼的后果（帝座受诸恶侵凌），与「帝为无道主」同为判断，采乙；「考究要知因」是提示语，不是断语。\"\n  },\n  {\n   \"编号\": \"qs-1-16-2:s008\",\n   \"断语\": [\n    {\n     \"条件原文\": \"天府\",\n     \"判断原文\": \"不喜四杀冲破\"\n    },\n    {\n     \"条件原文\": \"四杀冲破\",\n     \"判断原文\": \"虽无官贵\"\n    },\n    {\n     \"条件原文\": \"四杀冲破\",\n     \"判断原文\": \"亦主财田富足\"\n    }\n   ],\n   \"理由\": \"「虽无官贵」（无官贵）与「亦主财田富足」是同一条件下的两个判断，按一条件带几个判断各算一条的规则拆开，采乙。\"\n  },\n  {\n   \"编号\": \"qs-2-2-47:s001\",\n   \"断语\": [\n    {\n     \"条件原文\": \"庙旺\",\n     \"判断原文\": \"终身富贵\"\n    },\n    {\n     \"条件原文\": \"陷地虽化权禄\",\n     \"判断原文\": \"也凶\"\n    },\n    {\n     \"条件原文\": \"陷地\",\n     \"判断原文\": \"官禄亦不显\"\n    },\n    {\n     \"条件原文\": \"陷地\",\n     \"判断原文\": \"先勤终懒\"\n    },\n    {\n     \"条件原文\": \"陷地\",\n     \"判断原文\": \"成败不一\"\n    },\n    {\n     \"条件原文\": \"陷地\",\n     \"判断原文\": \"出外离祖可吉\"\n    }\n   ],\n   \"理由\": \"「虽化权禄」是让步条件，判断是「也凶」，此处从乙；其后数条判断仍以「陷地」为条件，「虽化权禄」只管「也凶」一句；「出外离祖可吉」是陷地之下的整体判断（宜离祖出外），「出外离祖」不是命理条件，此处从甲。\"\n  },\n  {\n   \"编号\": \"qs-2-2-294:s001\",\n   \"断语\": [\n    {\n     \"条件原文\": \"破军七杀与贪狼，入庙\",\n     \"判断原文\": \"英雄不可当\"\n    },\n    {\n     \"条件原文\": \"破军七杀与贪狼，入庙\",\n     \"判断原文\": \"关羽命逢为上将\"\n    },\n    {\n     \"条件原文\": \"破军七杀与贪狼，入庙\",\n     \"判断原文\": \"庶人富足置田庄\"\n    }\n   ],\n   \"理由\": \"三句都是「破军七杀与贪狼，入庙」这一命理条件带出的判断；「关羽命逢」「庶人」是举例与人群分述，不是星曜宫位条件，不宜作条件原文，采乙。\"\n  },\n  {\n   \"编号\": \"qs-2-2-413:s001\",\n   \"断语\": [\n    {\n     \"条件原文\": \"限遇陀罗\",\n     \"判断原文\": \"事亦多\"\n    },\n    {\n     \"条件原文\": \"限遇陀罗\",\n     \"判断原文\": \"必然忍耐要谦和\"\n    },\n    {\n     \"条件原文\": \"若无吉曜同相会\",\n     \"判断原文\": \"须教一梦入南柯\"\n    }\n   ],\n   \"理由\": \"「必然忍耐要谦和」是由限遇陀罗推出的处境判断（须忍耐谦和方可），与「须防脓血」「出外离祖可吉」一类同属断语，不应漏掉，采甲。\"\n  },\n  {\n   \"编号\": \"qs-2-6-17:s001\",\n   \"断语\": [\n    {\n     \"条件原文\": \"天机同\",\n     \"判断原文\": \"劳心用力发财不多\"\n    },\n    {\n     \"条件原文\": \"天机同\",\n     \"判断原文\": \"更改方见成家\"\n    },\n    {\n     \"条件原文\": \"加羊陀火铃空劫\",\n     \"判断原文\": \"先难后易\"\n    },\n    {\n     \"条件原文\": \"加羊陀火铃空劫\",\n     \"判断原文\": \"仅足度日\"\n    }\n   ],\n   \"理由\": \"「先难后易」与「仅足度日」是同一条件下的两个独立判断，按规则各算一条，采乙。\"\n  },\n  {\n   \"编号\": \"qs-3-1-7:s002\",\n   \"断语\": [],\n   \"理由\": \"「尤外」只是对前句判断的例外/程度提示，本身没有说出吉凶、性情等判断内容；「有田宅疾厄已录于后」是编排说明，故全句不列断语，采乙。\"\n  }\n ]\n}"
