     "条件原文": "巨门命陷",
     "判断原文": "侍女偏房免灾殃"
    },
    {
     "条件原文": "巨门命陷",
     "判断原文": "相貌清奇"
    },
    {
     "条件原文": "巨门命陷",
     "判断原文": "多近宠"
    },
    {
     "条件原文": "巨门命陷",
     "判断原文": "寿夭或凶亡"
    }
   ],
   "理由": "全句命理条件只有「巨门命陷」一个，后文皆由它带出；「侍女偏房」是人事去向而非星曜宫位等命理条件，故「侍女偏房免灾殃」整句作一条判断（从甲）；「相貌清奇」是长相、「多近宠」是际遇，属一个条件带出两个判断，依 codebook 各算一条（从乙）；「不然寿夭或凶亡」条件同为巨门命陷。"
  },
  {
   "编号": "qs-3-18-7:s001",
   "断语": [
    {
     "条件原文": "戌亥羊陀",
     "判断原文": "须避忌"
    },
    {
     "条件原文": "戌亥生人忌遇羊陀",
     "判断原文": "灾重"
    },
    {
     "条件原文": "戌生人又行到戍宫岁限",
     "判断原文": "为地网"
    },
    {
     "条件原文": "行到辰宫岁限",
     "判断原文": "为天罗"
    },
    {
     "条件原文": "辰戌相冲",
     "判断原文": "不美"
    }
   ],
   "理由": "首句「戌亥羊陀」是生人与所遇之星的条件，「须避忌」才是判断，从乙；第四、五条中「又忌」「谓之」是连接语而非条件，条件原文应为「行到辰宫岁限」「辰戌相冲」，从甲；其余两条二人一致。"
  }
 ]
