  {
   "编号": "qs-1-4-3:s002",
   "断语": [
    {
     "条件原文": "贪狼天机",
     "判断原文": "是庙乐"
    },
    {
     "条件原文": "得天相水到寅",
     "判断原文": "为之旺相"
    },
    {
     "条件原文": "巨门水得卯",
     "判断原文": "为之疏通"
    },
    {
     "条件原文": "三方更得文曲水破军水相会",
     "判断原文": "尤妙"
    },
    {
     "条件原文": "又加禄存土",
     "判断原文": "极美矣"
    }
   ],
   "理由": "采乙。「是庙乐」是给贪狼天机二星定性的判断，其条件（二星）就在本句，按 codebook 条件在本句的应抄本句的字，不必从整段前文抄「寅乃木之垣」；其余四条两人一致。"
  },
  {
   "编号": "qs-2-1-151:s001",
   "断语": [
    {
     "条件原文": "化权",
     "判断原文": "属木"
    },
    {
     "条件原文": "化权",
     "判断原文": "喜会巨门武曲"
    }
   ],
   "理由": "采乙。「属木」是给化权星定性之语，属 codebook 所列「给星定名定性」一类断语，不是单讲星名由来，故应单列一条；「喜会巨门武曲」与之同条件、不同判断，各算一条。"
  },
  {
   "编号": "qs-2-2-428:s001",
   "断语": [
    {
     "条件原文": "铃星一宿",
     "判断原文": "不可当"
    },
    {
     "条件原文": "铃星一宿不可当，守临二限",
     "判断原文": "必癫狂"
    },
    {
     "条件原文": "若无吉曜来相照",
     "判断原文": "未免招灾惹祸殃"
    }
   ],
   "理由": "采甲。「一宿」是指称铃星这颗星的主语成分，不是判断内容，判断自「不可当」起，故条件原文应为「铃星一宿」；后两条两人一致。"
  },
  {
   "编号": "qs-2-10-16:s001",
   "断语": [
    {
     "条件原文": "七杀庙旺",
     "判断原文": "武职峥嵘"
    },
    {
     "条件原文": "七杀庙旺",
     "判断原文": "权贵非小"
    },
    {
     "条件原文": "七杀庙旺",
     "判断原文": "不宜文人"
    },
    {
     "条件原文": "武曲同",
     "判断原文": "权贵"
    },
    {
     "条件原文": "廉贞同",
     "判断原文": "功名显达"
    }
   ],
   "理由": "采甲。「武职峥嵘」与「权贵非小」是同一条件带出的两个判断（一说职业、一说地位），按 codebook 一个条件带出几个判断的应各算一条；其余三条两人一致。"
  },
  {
   "编号": "qs-3-20-193:s001",
