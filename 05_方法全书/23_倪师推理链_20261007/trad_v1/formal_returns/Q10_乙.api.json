     "text": "{\n \"批\": \"Q10\",\n \"归类\": [\n  {\n   \"编号\": \"qs-3-20-64:s001#1\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": \"是\",\n   \"C3依据\": \"巳宫酉逢\",\n   \"C4\": \"否\",\n   \"C4依据\": \"\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"\"\n  },\n  {\n   \"编号\": \"qs-3-20-64:s001#2\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": \"是\",\n   \"C3依据\": \"巳宫酉逢\",\n   \"C4\": \"否\",\n   \"C4依据\": \"\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"\"\n  },\n  {\n   \"编号\": \"qs-3-20-64:s001#3\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": \"是\",\n   \"C3依据\": \"巳宫酉逢\",\n   \"C4\": \"否\",\n   \"C4依据\": \"\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"\"\n  },\n  {\n   \"编号\": \"qs-1-10-9:s001#1\",\n   \"问A\": \"定名\",\n   \"问B\": \"象名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"结论是说紫微居官禄身命时「最要左右守卫」，讲的是星的喜忌性质而非人事，故归定名；「守卫」取护卫之人象，故答象名，但亦可视为抽象的宜得辅佐之义。\"\n  },\n  {\n   \"编号\": \"qs-1-15-1:s003#1\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"「化囚为杀」是给廉贞在不临庙旺更犯官符时定的性质名目；囚、杀偏向凶恶性质，故答义名，但「囚」亦可作人象看。\"\n  },\n  {\n   \"编号\": \"qs-2-2-479:s001#1\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"「最喜吉星扶」说的是权星的喜忌性质，不是直接说人，故归定名义名。\"\n  },\n  {\n   \"编号\": \"qs-2-2-479:s001#2\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": \"是\",\n   \"C3依据\": \"权星最喜吉星扶\",\n   \"C4\": \"否\",\n   \"C4依据\": \"\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"权星即化权（四化），吉星扶为会照关系，故按位答；若视权星仅为一颗星、吉星扶仅为组合，则应为直断。\"\n  },\n  {\n   \"编号\": \"qs-2-2-479:s001#3\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": \"否\",\n   \"C3依据\": \"\",\n   \"C4\": \"否\",\n   \"C4依据\": \"\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"\"\n  },\n  {\n   \"编号\": \"qs-3-19-2:s001#1\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": \"是\",\n   \"C3依据\": \"逢震巽\",\n   \"C4\": \"是\",\n   \"C4依据\": \"土到东南\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"此为行限宫歌，「土到东南」是行限走到东南方宫位，兼含时与位；未明说土木相克之理，故不答C1、问D。\"\n  },\n  {\n   \"编号\": \"qs-3-19-2:s001#2\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": \"是\",\n   \"C3依据\": \"吉曜相逢照\",\n   \"C4\": \"是\",\n   \"C4依据\": \"土到东南\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"「纵然吉曜相逢照」是让步条件，官灾的根本理由仍是上句行限土到东南逢震巽，故时、位并答。\"\n  },\n  {\n   \"编号\": \"qs-2-11-13:s001#1\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": \"是\",\n   \"C3依据\": \"入庙旺\",\n   \"C4\": \"否\",\n   \"C4依据\": \"\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"\"\n  },\n  {\n   \"编号\": \"qs-2-11-13:s001#2\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": 