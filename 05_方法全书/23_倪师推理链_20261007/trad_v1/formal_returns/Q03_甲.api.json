 \"\",\n   \"C4\": \"是\",\n   \"C4依据\": \"逢恶限\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"\"\n  },\n  {\n   \"编号\": \"qs-1-13-2:s003#1\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"说的是武曲与太阴在星性上互为权柄，是给星定性质而非说人，「互权」为抽象性质，归义名。\"\n  },\n  {\n   \"编号\": \"qs-1-13-2:s003#2\",\n   \"问A\": \"定名\",\n   \"问B\": \"象名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"把天府、天相称为武曲的「佐贰之星」，佐贰是官职人物形象，归象名。\"\n  },\n  {\n   \"编号\": \"qs-1-13-2:s003#3\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"说武曲专司财帛田宅，是说它所主之事，归义名。\"\n  },\n  {\n   \"编号\": \"qs-1-21-2:s008#1\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依据\": \"\",\n   \"C2\": \"否\",\n   \"C2依据\": \"\",\n   \"C3\": \"否\",\n   \"C3依据\": \"\",\n   \"C4\": \"否\",\n   \"C4依据\": \"\",\n   \"C5\": \"否\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"整段开头说天梁「化气为荫为寿」，此句可视为荫的实例，但相隔较远且未明连为理由，故按直断处理；拿不准。\"\n  },\n  {\n   \"编号\": \"qs-2-2-196:s001#1\",\n   \"问A\": \"定名\",\n   \"问B\": \"义名\",\n   \"C1\": \"\",\n   \"C1依据\": \"\",\n   \"C2\": \"\",\n   \"C2依据\": \"\",\n   \"C3\": \"\",\n   \"C3依据\": \"\",\n   \"C4\": \"\",\n   \"C4依据\": \"\",\n   \"C5\": \"\",\n   \"C5依据\": \"\",\n   \"问D\": \"否\",\n   \"备注\": \"「更喜人生四墓生」是说这种盘面情形喜什么条件，是给情形定喜忌性质而非直接说人怎样，故归定名；亦可能被视为断事，拿不准。\"\n  },\n  {\n   \"编号\": \"qs-2-2-196:s001#2\",\n   \"问A\": \"断事\",\n   \"问B\": \"\",\n   \"C1\": \"否\",\n   \"C1依