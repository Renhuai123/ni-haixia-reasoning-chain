     "text": "{\n \"批\": \"N04\",\n \"归类\": [\n  {\"编号\":\"T118-c1\",\"问A\":\"定名\",\"问B\":\"象名\",\"C1\":\"\",\"C1依据\":\"\",\"C2\":\"\",\"C2依据\":\"\",\"C3\":\"\",\"C3依据\":\"\",\"C4\":\"\",\"C4依据\":\"\",\"C5\":\"\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T118-c2\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"原文只说廉贞星的人长相清秀，前句「桃花星」未被用作理由（「除了……那」是并列），按直断。\"},\n  {\"编号\":\"T135-c1\",\"问A\":\"定名\",\"问B\":\"象名\",\"C1\":\"\",\"C1依据\":\"\",\"C2\":\"\",\"C2依据\":\"\",\"C3\":\"\",\"C3依据\":\"\",\"C4\":\"\",\"C4依据\":\"\",\"C5\":\"\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"「男人的命」是给杀破狼组合定性质；名目里有「男人」这一具体人物字，按规则取象名，但也可视为抽象性质。\"},\n  {\"编号\":\"T138-c1\",\"问A\":\"定名\",\"问B\":\"义名\",\"C1\":\"\",\"C1依据\":\"\",\"C2\":\"\",\"C2依据\":\"\",\"C3\":\"\",\"C3依据\":\"\",\"C4\":\"\",\"C4依据\":\"\",\"C5\":\"\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T206-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T206-c2\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"后文「长就毛茸茸的……」只是解释「长绒肥胖」的意思，不是说凭什么。\"},\n  {\"编号\":\"T216-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"是\",\"C2依据\":\"唯一一个四个字给你天相以后，代表天相了以后\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"是\",\"C4依据\":\"45-54她十年中间\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"原文把「位高无权」当作天相的本来特征（四个字），再因大限本宫是天相而断此十年如此；后面「干副总监」是举例，不是解释。\"},\n  {\"编号\":\"T302-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"是\",\"C4依据\":\"流年流到火星铃星\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"火星→火厄可能是取星名字面，但原文未明说，故C1答否。\"},\n  {\"编号\":\"T302-c10\",