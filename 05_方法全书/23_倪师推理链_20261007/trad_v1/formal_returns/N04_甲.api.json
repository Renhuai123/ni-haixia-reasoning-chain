\":\"\",\"C3依据\":\"\",\"C4\":\"\",\"C4依据\":\"\",\"C5\":\"\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"「巨门星讲的官司是非」是说巨门所主之事，不是说某人有官司，故按定名·义名。\"},\n  {\"编号\":\"T375-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"是\",\"C3依据\":\"化忌就红鸾星就没有了\",\"C4\":\"是\",\"C4依据\":\"过了3233那个化忌……你十年化忌嘛\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T375-c2\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"是\",\"C2依据\":\"红鸾星就没有了，所以婚姻非常不好\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"前提（姻缘不动）与结论（婚姻不好）同属婚姻一类，结论近于前提的同义或概括说法，按C2；亦可视为后果（C5）。\"},\n  {\"编号\":\"T376-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"是\",\"C3依据\":\"她红鸾天喜星来会\",\"C4\":\"是\",\"C4依据\":\"刚好十年大运进入夫妻\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T476-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"是\",\"C3依据\":\"刚好在夫妻宫\",\"C4\":\"是\",\"C4依据\":\"她流年逢到的时候\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T476-c2\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"是\",\"C5依据\":\"夫妻指定冲突很大，他觉得活的没有意思的\",\"问D\":\"是\",\"备注\":\"「活的没有爱情了没有意思了」补说了为什么觉得没意思，勉强算明说道理。\"},\n  {\"编号\":\"T476-c3\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"是\",\"C5依据\":\"活的没有爱情了没有意思了，就自杀了\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T497-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"是\",\"C2依据\":\"这种杀星进来的话\",\"C3\":\"是\",\"C3依据\":\"夫妻宫如果遇到廉破\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T533-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"是\",\"C2依据\":\"先生命中有两个……还是照样会生两个\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"结论「生两个」就是前提「先生命中有两个」的实现，按前提与结论同类（C2）；原文未说为什么以先生为准，也可视为直断。\"},\n  {\"编号\":\"T533-c2\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"是\",\"C5依据\":\"先生命中有两个太太命里面没有……生的两个都比较像先生\",\"问D\":\"否\",\"备注\":\"由「子女出自先生命中而非太太命中」这一处境按常理推出像先生，归C5；拿不准。\"},\n  {\"编号\":\"T567-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"是\",\"C3依据\":\"走到财帛宫\",\"C4\":\"是\",\"C4依据\":\"走到财帛宫\",\"C5\":\"是\",\"C5依据\":\"在公司里面做了半天很郁卒……心里面不愉快，然后她出来自己做生意当老板\",\"问D\":\"否\",\"备注\":\"运走到财帛宫兼有宫位与时机两层；中间「郁卒」的叙述把处境当作出来当老板的前因。\"},\n  {\"编号\":\"T569-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"是\",\"C1依据\":\"晚上出太阳在财帛宫\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"是\",\"C3依据\":\"太阳星落陷在这里面，如果它是坐财帛\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"是\",\"备注\":\"「做生意当老板的人，一定要有权有禄才行」是进一步说明为什么不行；但它是另一条件而非解释「晚上出太阳」本身，拿不准。\"},\n  {\"编号\":\"T569-c2\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"是\",\"C3依据\":\"一定要有权有禄才行\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T572-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"原话摘录只说「这就已经定出来了」，未说明凭哪颗星或四化，按直断；后文「没有破军」的对照只是暗示。\"},\n  {\"编号\":\"T572-c2\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"否\",\"C2依据\":\"\",\"C3\":\"否\",\"C3依据\":\"\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"同T572-c1。\"},\n  {\"编号\":\"T572-c3\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"是\",\"C2依据\":\"财帛宫都是财星\",\"C3\":\"是\",\"C3依据\":\"财帛宫没有破军，他财帛宫都是财星化权\",\"C4\":\"否\",\"C4依据\":\"\",\"C5\":\"否\",\"C5依据\":\"\",\"问D\":\"否\",\"备注\":\"\"},\n  {\"编号\":\"T600-c1\",\"问A\":\"断事\",\"问B\":\"\",\"C1\":\"否\",\"C1依据\":\"\",\"C2\":\"